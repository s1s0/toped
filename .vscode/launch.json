    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/toped.app",
            "args": ["tcase.tll"],
            "environment": [
                            { "name": "TPD_GLOBAL", "value":"/Users/siso/github/toped"     },
                            { "name": "TPD_LOCAL" , "value": "/Users/siso/githhub/toped"   }
                        ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "externalConsole": false,
            "MIMode": "lldb"
        }

    ]
}